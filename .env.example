# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,9004-2401-4900-8825-d714-ac64-3e13-5971-b367.ngrok-free.app
DATABASE_URL=postgres://localhost:5432/imax_accounting
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Must be the SAME value the original app used if you ever import existing encrypted Plaid/GHL tokens.
TOKEN_ENCRYPTION_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Must be publicly reachable for Plaid to deliver webhooks (use an ngrok/cloudflared URL in dev, your HTTPS API host in prod)
PLAID_WEBHOOK_URL=http://localhost:8000/api/v1/webhooks/plaid/
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Install flow: open GET /api/v1/workspace/install/ -> redirects to the GHL consent screen built from these values.
# GHL_VERSION_ID defaults to the part of GHL_CLIENT_ID before the dash. GHL_SCOPES is space separated.
GHL_REDIRECT_URI=http://localhost:8000/api/v1/workspace/oauth/callback/
# Bearer secret for scheduled jobs (token refresh)
CRON_SECRET=
# Optional hardening: require a signed ?sig= on GHL sign-in links (leave empty to match the original app)
GHL_LINK_SECRET=

CELERY_BROKER_URL=redis://localhost:6379/0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
GHL_VERSION_ID=
# Optional: marketplace app id used to list installed locations (defaults to GHL_VERSION_ID)
GHL_APP_ID=
GHL_SCOPES="invoices.readonly payments/transactions.readonly oauth.readonly oauth.write"
