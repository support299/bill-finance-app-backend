# Production /srv/imax/backend/.env  (chmod 600). Replace every YOUR_* value.
DJANGO_SECRET_KEY=YOUR_LONG_RANDOM_STRING
DEBUG=False
ALLOWED_HOSTS=YOUR_DOMAIN
DATABASE_URL=postgres://imax:YOUR_DB_PASSWORD@localhost:5432/imax_accounting

# Same-origin deployment (frontend and API on one domain)
FRONTEND_URL=https://YOUR_DOMAIN
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN
CSRF_TRUSTED_ORIGINS=https://YOUR_DOMAIN

# Encrypts Plaid/GHL tokens and vendor TINs. Generate once, back it up, never change it.
TOKEN_ENCRYPTION_KEY=YOUR_ANOTHER_LONG_RANDOM_STRING

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://YOUR_DOMAIN/api/v1/webhooks/plaid/

GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=https://YOUR_DOMAIN/api/v1/workspace/oauth/callback/
GHL_VERSION_ID=
GHL_SCOPES="invoices.readonly payments/transactions.readonly oauth.readonly oauth.write locations.readonly"
CRON_SECRET=YOUR_RANDOM_STRING
# GHL_LINK_SECRET=YOUR_RANDOM_STRING   # recommended: require signed ?id= links

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Password-reset emails (use SES/SendGrid/etc.; without these the link is only printed to the service log)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@YOUR_DOMAIN
